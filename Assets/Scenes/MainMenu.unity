--- !u!114 &407267225
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 407267223}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02f663ace3a60df468de9010502ccdac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  quizCategories:
  - categoryName: Array
    questions:
    - question: 'What is the time complexity of accessing an element in an array
        by index? '
      options:
      - ' O(n) '
      - O(log n)
      - 'O(1) '
      - O(n log n)
      correctAnswerIndex: 2
    - question: Which of the following best describes an array?
      options:
      - A dynamic data structure with unlimited size
      - A collection of elements stored at non-contiguous memory locations
      - A fixed-size data structure storing elements of the same data type
      - 'A hierarchical data structure '
      correctAnswerIndex: 2
    - question: What happens when inserting an element in the middle of an array?
      options:
      - 'The array size is automatically increased '
      - Elements to the right of the insertion point must be shifted
      - The new element replaces the existing element at that index
      - The array gets reorganized into a linked list
      correctAnswerIndex: 1
    - question: Which of the following types of arrays is used for representing a
        matrix?
      options:
      - 'Single-dimensional array '
      - Multi-dimensional array
      - 'Circular array '
      - Sparse array
      correctAnswerIndex: 1
    - question: What is the main advantage of arrays over linked lists?
      options:
      - Dynamic memory allocation
      - Faster traversal and direct access
      - Easier deletion of elements
      - Better for implementing stacks and queues
      correctAnswerIndex: 1
  - categoryName: Linked List
    questions:
    - question: 'What is a key characteristic of a linked list? '
      options:
      - Elements are stored in contiguous memory locations
      - Each node contains a reference to the next node
      - 'Elements can be accessed in O(1) time '
      - It cannot store duplicate elements
      correctAnswerIndex: 1
    - question: Which type of linked list allows traversal in both directions?
      options:
      - Singly linked list
      - Doubly linked list
      - Circular linked list
      - None of the above
      correctAnswerIndex: 1
    - question: What is the time complexity of inserting a node at the beginning
        of a singly linked list?
      options:
      - O(1)
      - O(n)
      - O(log n)
      - O(n log n)
      correctAnswerIndex: 0
    - question: 'Which of the following is an advantage of linked lists over arrays? '
      options:
      - Constant-time access to any element
      - Dynamic memory allocation
      - Uses less memory per element
      - No need for extra pointers
      correctAnswerIndex: 1
    - question: 'What is a potential drawback of using a linked list? '
      options:
      - Fixed size
      - Slower insertion and deletion
      - Extra memory for pointers
      - Elements must be of the same type
      correctAnswerIndex: 2
  - categoryName: Stack
    questions:
    - question: What is the principle behind stack operations?
      options:
      - First-In, First-Out (FIFO)
      - Last-In, First-Out (LIFO)
      - Random order
      - None of the above
      correctAnswerIndex: 1
    - question: 'Which of the following is not an operation performed on a stack? '
      options:
      - Push
      - Pop
      - Peek
      - Enqueue
      correctAnswerIndex: 3
    - question: What is the time complexity of pushing an element onto a stack?
      options:
      - O(1)
      - 'O(n) '
      - 'O(log n) '
      - 'O(n log n) '
      correctAnswerIndex: 0
    - question: 'What happens when you try to pop an element from an empty stack? '
      options:
      - Returns a default value
      - Causes a stack overflow
      - Results in a stack underflow error
      - Nothing happens
      correctAnswerIndex: 2
    - question: Which data structure is commonly used for function call management
        in programming languages?
      options:
      - Queue
      - Stack
      - Linked list
      - Graph
      correctAnswerIndex: 1
  - categoryName: Queue
    questions:
    - question: What is the primary principle behind a queue?
      options:
      - First-In, First-Out (FIFO)
      - Last-In, First-Out (LIFO)
      - Random order
      - None of the above
      correctAnswerIndex: 0
    - question: Which operation adds an element to the end of a queue?
      options:
      - Push
      - Pop
      - Enqueue
      - Dequeue
      correctAnswerIndex: 2
    - question: What is the time complexity of enqueuing an element into a queue?
      options:
      - O(1)
      - O(n)
      - O(log n)
      - O(n log n)
      correctAnswerIndex: 0
    - question: 'What happens when you try to dequeue an element from an empty queue? '
      options:
      - It returns the last inserted element
      - It causes an underflow error
      - It returns a null value
      - It removes an arbitrary element
      correctAnswerIndex: 2
    - question: What is a circular queue?
      options:
      - A queue that never gets full
      - A queue implemented using a linked list
      - A queue where the last position is connected to the first
      - A queue with random insertions and deletions
      correctAnswerIndex: 2
